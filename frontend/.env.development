# Dùng khi chạy dev (npm run dev)
# Khi dev, backend thường chạy riêng ở một port (vd 4000) và không có Nginx
# đứng trước, nên vẫn dùng path tương đối nhưng cấu hình proxy trong vite dev
# server (xem vite.config.js nếu muốn thêm server.proxy), hoặc chạy backend
# và set CORS phù hợp. Ở đây để mặc định giống production path để code không
# rẽ nhánh giữa dev/production.
VITE_API_BASE=/video-call/api
VITE_SOCKET_PATH=/video-call/socket.io
VITE_BASE_PATH=/video-call/

# CHỈ dùng cho vite dev server proxy (server.proxy trong vite.config.js).
# Không được dùng biến này trong source code (main.jsx, config.js, ...).
VITE_DEV_BACKEND_ORIGIN=http://localhost:4000
