# Copy file này thành .env và chỉnh theo từng môi trường/server.
# Mỗi project chạy trên VPS phải có PORT khác nhau (Nginx sẽ proxy
# theo port này). Backend không cần biết domain hay sub-path
# (/video-call) — việc đó do Nginx xử lý.

PORT=4000

# Danh sách origin được phép gọi API (CORS). Khi chạy sau Nginx trên
# cùng domain thì thường KHÔNG cần CORS (same-origin), biến này chủ
# yếu hữu ích khi dev frontend/backend riêng biệt hoặc gọi cross-origin.
# Có thể để trống hoặc liệt kê domain thật khi lên production.
CORS_ORIGINS=http://localhost:5173
